# tgmux gateway on a server (instance "default").
#
# Code:   /opt/tgmux (git work tree, venv in /opt/tgmux/.venv)
# Config: /root/.config/tgmux/default/     config.toml, telegram.env, reporter.token
# State:  /root/.local/state/tgmux/default/ telegram.session, tgmux.db, gateway.sock, locks/
#
# Install once:
#   cp /opt/tgmux/deploy/tgmux.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now tgmux
# Logs:  journalctl -u tgmux -f

[Unit]
Description=tgmux gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/tgmux
ExecStartPre=/opt/tgmux/.venv/bin/tgmux serve --check
ExecStart=/opt/tgmux/.venv/bin/tgmux serve
# serve exits 1 when Telegram drops the connection; come back and catch up.
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The session (update state), registry, socket and locks live here.
ReadWritePaths=/root/.local/state/tgmux

[Install]
WantedBy=multi-user.target
